#version 460 core
// (a) Acceleration structure read from the resource heap through GL_EXT_descriptor_heap. The
// array stride defaults to the driver's acceleration-structure descriptor size.
#extension GL_EXT_ray_query : require
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(buffer_reference, std430) buffer Out { uint data[]; };
layout(set = 0, binding = 0, std140) uniform Root
{
    Out out_ptr;
    uint64_t tlas;
    uint heap_index;
    uint width;
    uint height;
    uint pad;
} root;
layout(descriptor_heap) uniform accelerationStructureEXT heap_scene[];

layout(local_size_x = 8, local_size_y = 8) in;

void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    vec2 uv = (vec2(id) + 0.5) / vec2(root.width, root.height);
    rayQueryEXT query;
    rayQueryInitializeEXT(query, heap_scene[root.heap_index], gl_RayFlagsOpaqueEXT, 0xFF,
                          vec3(uv, -1.0), 0.0, vec3(0.0, 0.0, 1.0), 4.0);
    while (rayQueryProceedEXT(query)) {}
    uint value = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT
        ? rayQueryGetIntersectionInstanceCustomIndexEXT(query, true) + 1 : 0;
    if (id.x < root.width && id.y < root.height)
        root.out_ptr.data[id.y * root.width + id.x] = value;
}
