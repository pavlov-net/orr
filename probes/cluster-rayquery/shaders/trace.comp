#version 460 core
// glslang twin of trace.slang (WITH_CLUSTER): separates Slang code generation from driver
// behaviour. Same root, same record layout.
#extension GL_EXT_ray_query : require
#extension GL_NV_cluster_acceleration_structure : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(buffer_reference, scalar) buffer Out { uint data[]; };
layout(push_constant, scalar) uniform Root
{
    Out out_ptr;
    uint64_t tlas;
    uint width;
    uint height;
    uint mode;
    uint pad;
} root;

layout(local_size_x = 8, local_size_y = 8) in;

const uint MODE_FORCE_NON_OPAQUE = 1;
const uint MODE_ALPHA = 2;
const uint MODE_OMM_2_STATE = 4;
const uint REC = 20;
const uint NONE = 0xffffffffu;

bool alpha_keep(uint cluster, uint prim) { return (cluster + prim) % 3 != 0; }

void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= root.width || id.y >= root.height)
        return;
    vec2 uv = (vec2(id) + 0.5) / vec2(root.width, root.height);
    uint flags = gl_RayFlagsNoneEXT;
    if ((root.mode & MODE_FORCE_NON_OPAQUE) != 0)
        flags |= gl_RayFlagsNoOpaqueEXT;
    if ((root.mode & MODE_OMM_2_STATE) != 0)
        flags |= 0x400u; // gl_RayFlagsForceOpacityMicromap2StateEXT
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(root.tlas), flags, 0xFF, vec3(uv, -1.0), 0.0,
                          vec3(0.0, 0.0, 1.0), 4.0);
    uint candidates = 0;
    float best_t = 1e30;
    uint best_cluster = NONE;
    uint best_prim = NONE;
    while (rayQueryProceedEXT(q))
    {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT)
            continue;
        candidates += 1;
        float t = rayQueryGetIntersectionTEXT(q, false);
        uint cluster = uint(rayQueryGetIntersectionClusterIdNV(q, false));
        uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
        if (t < best_t)
        {
            best_t = t;
            best_cluster = cluster;
            best_prim = prim;
        }
        if ((root.mode & MODE_ALPHA) == 0 || alpha_keep(cluster, prim))
            rayQueryConfirmIntersectionEXT(q);
    }
    uint base = (id.y * root.width + id.x) * REC;
    bool hit = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
    root.out_ptr.data[base + 0] = hit ? 1 : 0;
    root.out_ptr.data[base + 1] = hit ? uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)) : NONE;
    root.out_ptr.data[base + 2] = hit ? uint(rayQueryGetIntersectionInstanceIdEXT(q, true)) : NONE;
    root.out_ptr.data[base + 3] = hit ? uint(rayQueryGetIntersectionClusterIdNV(q, true)) : NONE;
    root.out_ptr.data[base + 4] = hit ? uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)) : NONE;
    root.out_ptr.data[base + 5] = hit ? uint(rayQueryGetIntersectionGeometryIndexEXT(q, true)) : NONE;
    root.out_ptr.data[base + 6] = hit ? floatBitsToUint(rayQueryGetIntersectionTEXT(q, true)) : NONE;
    root.out_ptr.data[base + 7] = candidates;
    root.out_ptr.data[base + 8] = best_cluster;
    root.out_ptr.data[base + 9] = best_prim;
    for (uint k = 0; k < 9; ++k)
        root.out_ptr.data[base + 10 + k] = NONE;
    if (hit)
    {
        vec3 p[3];
        rayQueryGetIntersectionTriangleVertexPositionsEXT(q, true, p);
        for (uint v = 0; v < 3; ++v)
        {
            root.out_ptr.data[base + 10 + v * 3 + 0] = floatBitsToUint(p[v].x);
            root.out_ptr.data[base + 10 + v * 3 + 1] = floatBitsToUint(p[v].y);
            root.out_ptr.data[base + 10 + v * 3 + 2] = floatBitsToUint(p[v].z);
        }
    }
    root.out_ptr.data[base + 19] = 0x600d;
}
