// glslang control for the Slang FromRayQuery + reorder case (mini 7, classic layout).
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_invocation_reorder : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(buffer_reference, scalar) buffer Words { uint w[]; };

layout(push_constant, scalar) uniform Root
{
    uint64_t tlas;
    uint64_t insts;
    uint64_t clusters;
    uint64_t pos;
    uint64_t uv;
    uint64_t idx;
    uint64_t out_rad;
    uint64_t out_hash;
    uint64_t out_stats;
    uint width;
    uint height;
    uint frame;
    uint bounces;
    uint tex;
    uint flags;
    uint salt;
    uint shade_scale;
    float cam[16];
    float sun[4];
} root;

layout(location = 0) hitObjectAttributeEXT vec2 attr;

void main()
{
    uvec2 px = gl_LaunchIDEXT.xy;
    vec2 ndc = (vec2(px) + 0.5) / vec2(root.width, root.height) * 2.0 - 1.0;
    vec3 o = vec3(root.cam[0], root.cam[1], root.cam[2]);
    vec3 fwd = vec3(root.cam[4], root.cam[5], root.cam[6]);
    vec3 right = vec3(root.cam[8], root.cam[9], root.cam[10]);
    vec3 up = vec3(root.cam[12], root.cam[13], root.cam[14]);
    vec3 d = normalize(fwd + right * (ndc.x * root.cam[3] * root.cam[7]) - up * (ndc.y * root.cam[3]));
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(root.tlas), gl_RayFlagsOpaqueEXT, 0xff, o, 0.0, d, 1e4);
    while (rayQueryProceedEXT(q))
    {
    }
    hitObjectEXT h;
    hitObjectRecordFromQueryEXT(h, q, 0, 0);
    reorderThreadEXT(h, rayQueryGetIntersectionTypeEXT(q, true) != 0 ? 1u : 0u, 1);
    uint v = hitObjectIsHitEXT(h) ? uint(hitObjectGetPrimitiveIndexEXT(h)) + 1u : 0u;
    Words(root.out_hash).w[px.y * root.width + px.x] = v;
}
